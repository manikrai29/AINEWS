# Copy to .env and fill in. NEVER commit the real .env (.gitignore already blocks it).

# --- n8n host config ---
TZ=America/Toronto
N8N_HOST=localhost
N8N_PROTOCOL=http

# Public base URL. Only needed for the Telegram approval trigger (Workflow B).
# Local test (Workflow A only): leave as-is.
# Production with approvals: set to your HTTPS domain, e.g. https://n8n.yourdomain.com/
WEBHOOK_URL=http://localhost:5678/

# Encrypts saved credentials. Generate ONCE and keep it forever:
#   openssl rand -hex 24
# If you lose/change it, every saved credential becomes undecryptable.
N8N_ENCRYPTION_KEY=

# --- NOT set here: API keys/tokens. Add them as n8n CREDENTIALS in the UI ---
#   Anthropic  -> "Header Auth": header name x-api-key,    value sk-ant-...
#   Bannerbear -> "Header Auth": header Authorization,     value "Bearer <project key>"
#   Ayrshare   -> "Header Auth": header Authorization,     value "Bearer <api key>"
#   Telegram   -> "Telegram API": bot token from @BotFather
# Then replace the REPLACE_ placeholders in the two workflows:
#   - Telegram chat id (both workflows)
#   - Bannerbear template id (generate workflow)
