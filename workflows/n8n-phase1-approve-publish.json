{
  "name": "AI News — Phase 1 — Approve & Publish",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": {},
  "nodes": [
    {
      "parameters": {
        "content": "## AI News — Approve & Publish\n\nReacts to the **Approve / Reject** buttons from the Generate workflow.\n\nNo database: the publish-ready content is recovered from the original Telegram message's hidden `--AINEWS-- … --END--` block.\n\n**Wire:** Telegram credential (same bot), Ayrshare credential (Header Auth, Bearer), and the chat id on the confirm/reject nodes. On n8n Cloud the public URL is automatic, so the Telegram trigger just works once this workflow is **active**.",
        "height": 320,
        "width": 420
      },
      "id": "node-sticky",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [ -40, 40 ]
    },
    {
      "parameters": {
        "updates": [ "callback_query" ],
        "additionalFields": {}
      },
      "id": "node-tg-trigger",
      "name": "On approval button",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [ 0, 320 ],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CRED", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.callback_query.data }}",
              "rightValue": "approve",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [ 240, 320 ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text=($json.callback_query&&$json.callback_query.message&&$json.callback_query.message.text)||'';const parts=text.split('--AINEWS--');const seg=parts[1]?parts[1].split('--END--')[0].trim():'';let p={};try{p=JSON.parse(seg);}catch(e){}const post=(p.platforms&&(p.platforms.linkedin||p.platforms.x))||'';const body={post:post,platforms:['twitter','linkedin','instagram'],mediaUrls:p.image_url?[p.image_url]:[]};return {json:{draftId:p.url||'',body}};"
      },
      "id": "node-recover",
      "name": "Recover draft from message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 480, 220 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.ayrshare.com/api/post",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [ { "name": "content-type", "value": "application/json" } ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "node-ayrshare",
      "name": "Ayrshare — publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 720, 220 ],
      "credentials": { "httpHeaderAuth": { "id": "REPLACE_AYRSHARE_CRED", "name": "Ayrshare Bearer" } }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "REPLACE_TELEGRAM_CHAT_ID",
        "text": "={{ '✅ Published: ' + ($('Recover draft from message').item.json.draftId || '') }}",
        "additionalFields": {}
      },
      "id": "node-confirm",
      "name": "Confirm published",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [ 960, 220 ],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CRED", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "REPLACE_TELEGRAM_CHAT_ID",
        "text": "🚫 Rejected — not published.",
        "additionalFields": {}
      },
      "id": "node-rejected",
      "name": "Mark rejected",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [ 480, 440 ],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CRED", "name": "Telegram Bot" } }
    }
  ],
  "connections": {
    "On approval button": { "main": [ [ { "node": "Approved?", "type": "main", "index": 0 } ] ] },
    "Approved?": {
      "main": [
        [ { "node": "Recover draft from message", "type": "main", "index": 0 } ],
        [ { "node": "Mark rejected", "type": "main", "index": 0 } ]
      ]
    },
    "Recover draft from message": { "main": [ [ { "node": "Ayrshare — publish", "type": "main", "index": 0 } ] ] },
    "Ayrshare — publish": { "main": [ [ { "node": "Confirm published", "type": "main", "index": 0 } ] ] }
  }
}
